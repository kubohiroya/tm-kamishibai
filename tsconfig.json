{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "target": "ES2023",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.js",
    "src/**/*.ts",
    "bin/**/*.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.js",
    "scripts/**/*.ts",
    "site/**/*.js",
    "test/**/*.ts",
    "vitest.config.ts",
    "vitest.e2e.config.ts"
  ],
  "exclude": [
    "src/builder/generated/dsl4-playback-runtime-extension.js",
    // Synced byte for byte from kubohiroya/tm-kamishibai-docs and verified by the navigation
    // contract workflow, so this repository must not annotate them.
    "scripts/site-navigation.mjs",
    "site/site-shell.css"
  ]
}
