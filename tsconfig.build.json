{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  "exclude": [
    "src/builder/generated/dsl4-playback-runtime-extension.js",
    "src/builder/generated/dsl41-narrative-playback-runtime-extension.js",
    "src/builder/generated/dsl41-narrative-authoring-runtime-extension.js"
  ]
}
