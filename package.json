{
  "name": "@kubohiroya/tmpose-kamishibai",
  "version": "3.1.5",
  "private": false,
  "type": "module",
  "description": "TMPose紙芝居 — ポーズで進めるAIインタラクティブ紙芝居",
  "homepage": "https://kubohiroya.github.io/tmpose-kamishibai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/tmpose-kamishibai.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/tmpose-kamishibai/issues"
  },
  "exports": {
    "./builder": "./src/builder/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tmpose-kamishibai": "bin/tmpose-kamishibai.mjs"
  },
  "files": [
    "bin/",
    "src/builder/",
    "README.md",
    "LICENSE",
    "LICENSES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "sb3:build": "node scripts/sb3/build.mjs",
    "sb3:check": "sb3-toolchain check app",
    "sb3:import": "sb3-toolchain import --output app",
    "sb3:extensions:status": "sb3-toolchain extensions status app",
    "sb3:extensions:sync": "sb3-toolchain extensions sync app",
    "sb3:extensions:update": "sb3-toolchain extensions update app",
    "lint": "eslint src/builder bin app/extensions/kubohiroyaweblink.js scripts/sb3/build.mjs scripts/sb3/title-build-metadata.mjs test/builder.test.mjs test/docs-index.test.mjs test/documentation-license.test.mjs test/internal-specification.test.mjs test/title-build-metadata.test.mjs",
    "format": "prettier --check package.json src/builder bin app/extensions/kubohiroyaweblink.js scripts/sb3/build.mjs scripts/sb3/title-build-metadata.mjs test/builder.test.mjs test/docs-index.test.mjs test/documentation-license.test.mjs test/internal-specification.test.mjs test/title-build-metadata.test.mjs docs/general/06-developer-guide.md docs/general/07-internal-specification.md docs/general/LICENSE.md docs/workshops/LICENSE.md README.md LICENSES.md",
    "typecheck": "tsc --project tsconfig.builder.json",
    "preview:docs": "vivliostyle preview --config docs/vivliostyle.general.config.mjs",
    "preview:staff": "vivliostyle preview --config docs/vivliostyle.staff.config.mjs",
    "preview:workshop": "vivliostyle preview --config docs/vivliostyle.workshop.config.mjs",
    "pretest": "node scripts/sb3/prepare-test.mjs",
    "test": "node --test test/*.test.mjs",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "npm publish --dry-run --access public",
    "prepack": "pnpm lint && pnpm format && pnpm typecheck && node --test test/builder.test.mjs && pnpm pack:check",
    "tmpose-kamishibai": "node bin/tmpose-kamishibai.mjs"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "teachable-machine",
    "pose-recognition",
    "kamishibai"
  ],
  "author": "Hiroya Kubo",
  "license": "MPL-2.0",
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@kubohiroya/sb3-toolchain": "github:kubohiroya/sb3-toolchain#fa0d827a8ee0fe58436aa1e7a6c227e6ace44186",
    "@types/node": "^24.0.0",
    "@turbowarp/scratch-svg-renderer": "1.1.0",
    "@vivliostyle/cli": "11.1.0",
    "eslint": "^9.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.0.0",
    "rubygana": "github:kubohiroya/rubygana#a24b8a699a1b033546f4d1a47a63005f7af95735",
    "scratch-parser": "6.0.0",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#7b6768fc6dfef6b343a06f992587b74807043961",
    "scratch-vm": "github:TurboWarp/scratch-vm#c4823421cb7c17d8d8a89878851ce1668c26a21f",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
