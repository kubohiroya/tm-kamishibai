{
  "name": "@kubohiroya/tmpose-kamishibai",
  "version": "3.2.0",
  "private": false,
  "type": "module",
  "description": "TMPose紙芝居 — ポーズで進めるAIインタラクティブ紙芝居",
  "homepage": "https://kubohiroya.github.io/tmpose-kamishibai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubohiroya/tmpose-kamishibai.git"
  },
  "bugs": {
    "url": "https://github.com/kubohiroya/tmpose-kamishibai/issues"
  },
  "exports": {
    "./builder": "./src/builder/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "tmpose-kamishibai": "bin/tmpose-kamishibai.mjs"
  },
  "files": [
    "bin/",
    "src/builder/",
    "README.md",
    "LICENSE",
    "LICENSES.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "sb3:build": "node scripts/sb3/build.mjs",
    "sb3:check": "sb3-toolchain check app",
    "sb3:import": "sb3-toolchain import --output app",
    "sb3:extensions:status": "sb3-toolchain extensions status app",
    "sb3:extensions:sync": "sb3-toolchain extensions sync app",
    "sb3:extensions:update": "sb3-toolchain extensions update app",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{js,mjs,cjs}\" \".github/**/*.{yaml,yml}\" \"*.{json,md,yaml,yml}\"",
    "typecheck": "tsc --project tsconfig.builder.json",
    "pretest": "node scripts/sb3/prepare-test.mjs",
    "test": "node --test test/*.test.mjs",
    "predeploy": "pnpm run build",
    "deploy": "gh-pages -d dist",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:check": "npm publish --dry-run --access public",
    "prepack": "pnpm lint && pnpm format && pnpm typecheck && node --test test/builder.test.mjs && pnpm pack:check",
    "tmpose-kamishibai": "node bin/tmpose-kamishibai.mjs"
  },
  "keywords": [
    "turbowarp",
    "scratch",
    "teachable-machine",
    "pose-recognition",
    "kamishibai"
  ],
  "author": "Hiroya Kubo",
  "license": "MPL-2.0",
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@kubohiroya/sb3-toolchain": "github:kubohiroya/sb3-toolchain#f21dd1e746eb527cb8bbeb95c36ba89317ab89a2",
    "@turbowarp/scratch-svg-renderer": "1.1.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "gh-pages": "^6.3.0",
    "globals": "17.8.0",
    "prettier": "^3.0.0",
    "scratch-parser": "6.0.0",
    "scratch-render-fonts": "github:TurboWarp/scratch-render-fonts#7b6768fc6dfef6b343a06f992587b74807043961",
    "scratch-vm": "github:TurboWarp/scratch-vm#c4823421cb7c17d8d8a89878851ce1668c26a21f",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
